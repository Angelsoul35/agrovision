# Copy to .env and adjust. All variables are optional; defaults are safe for local use.

# Confidence below which an assessment is routed to manual (agronomist) review
# instead of being reported as a firm verdict.
AV_CLASSIFIER_MIN_CONFIDENCE=0.55

# Deterministic "clearly healthy" rule: a leaf whose green fraction is at or
# above this value and whose diseased-spot coverage is at or below
# AV_RULE_MAX_SPOT_COVERAGE is called healthy without consulting the model.
AV_RULE_GREEN_FRACTION=0.47
AV_RULE_MAX_SPOT_COVERAGE=0.02
